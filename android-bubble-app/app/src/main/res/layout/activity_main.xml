<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Card con Logo oficial izquierdo y Preview derecho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <!-- Logo superior izquierdo en contenedor circular con borde cian -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_cyan_border"
                android:padding="7dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/app_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Logo App Oficial" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SNDR LABS"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calidad Bubble"
                    android:textColor="@color/text_light"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v4.0.27 • Messenger Overlay"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Preview superior derecho: Círculo #0F172A, borde cian #00F2FE 2dp y app_logo dentro -->
            <FrameLayout
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_circle_cyan_border"
                android:padding="7dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/app_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="Preview Burbuja Flotante" />
            </FrameLayout>
        </LinearLayout>

        <!-- Tarjeta de Permiso de Superposición -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvPermissionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● VERIFICANDO PERMISO..."
                android:textColor="@color/neon_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Para funcionar como burbuja flotante sobre otras apps (Messenger Style), la aplicación requiere autorización para mostrarse sobre otras aplicaciones."
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btnGrantPermission"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_primary"
                android:text="🔑 CONCEDER PERMISO EN AJUSTES"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Botones de Acción Principales -->
        <Button
            android:id="@+id/btnStartBubble"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_primary"
            android:text="🚀 ACTIVAR BURBUJA FLOTANTE"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:elevation="4dp"
            android:shadowColor="#00D2FF"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnStopBubble"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_secondary"
            android:text="⏹️ DETENER BURBUJA"
            android:textColor="@color/coral_red"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

        <!-- Sección Colapsable: Registro de Eventos y Diagnóstico -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <!-- Encabezado / Botón de Toggle Colapsable -->
            <LinearLayout
                android:id="@+id/layoutLogHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tvLogTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛠️ REGISTRO DE EVENTOS Y DIAGNÓSTICO"
                    android:textColor="@color/neon_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLogCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="(0)"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvLogToggleIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▲"
                    android:textColor="@color/neon_cyan"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Contenido expandible -->
            <LinearLayout
                android:id="@+id/layoutLogContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp">

                <!-- Consola de logs con scroll propio -->
                <ScrollView
                    android:id="@+id/scrollLogViewer"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@drawable/bg_log_console"
                    android:padding="10dp"
                    android:nestedScrollingEnabled="true"
                    android:fadeScrollbars="false">

                    <TextView
                        android:id="@+id/tvLogViewer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="@color/text_light"
                        android:textIsSelectable="true"
                        android:text="[SISTEMA] Inicializando registros..." />
                </ScrollView>

                <!-- Barra de Acciones del Log -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnCopyLogs"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_log_copy"
                        android:text="📋 Copiar Registro"
                        android:textColor="@color/neon_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnClearLogs"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_btn_log_clear"
                        android:text="🗑️ Limpiar"
                        android:textColor="@color/coral_red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="6dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Tarjeta de Instrucciones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel_instructions"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 CÓMO USAR LA BURBUJA"
                android:textColor="@color/neon_cyan"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Tap simple: Expande o minimiza el panel de control de calidad.&#10;• Arrastre libre: Mueve la burbuja a cualquier punto de la pantalla.&#10;• Imantación: Al soltarla, se adhiere magnéticamente al borde lateral.&#10;• Teclado activo: Soporte nativo para registrar Lotes, Cantidades y Baldes de Merma.&#10;• File Picker: Carga directa de respaldos JSON/TXT desde la memoria del teléfono.&#10;• Diagnóstico: Monitoreo en tiempo real de errores JS, transferencias de archivos y ciclo de vida."
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnOpenWeb"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackground"
            android:text="🌐 Abrir versión Web en Navegador"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
